{%- style -%}
  .whats-included-features {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px 40px;
  }

  .whats-included-features__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .whats-included-features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .whats-included-features__card {
    border-radius: 8px;
    padding: 40px 30px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 250px;
    transition: all 0.3s ease;
  }

  .whats-included-features__card:nth-child(odd) {
    background-color: #ffffff;
    border: 1px solid #f0f0f0;
  }

  .whats-included-features__card:nth-child(even) {
    background-color: {{ section.settings.card_bg_color }};
  }

  .whats-included-features__icon {
    font-size: 48px;
    margin-bottom: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: transparent;
  }

  .whats-included-features__card:nth-child(odd) .whats-included-features__icon {
    background-color: #2a2a2a;
    color: #ffffff;
  }

  .whats-included-features__card:nth-child(even) .whats-included-features__icon {
    background-color: #ffffff;
    color: #2a2a2a;
  }

  .whats-included-features__title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 15px;
    color: {{ section.settings.title_color }};
  }

  .whats-included-features__description {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.description_color }};
  }

  .whats-included-features__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 1024px) {
    .whats-included-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .whats-included-features__grid {
      grid-template-columns: 1fr;
    }

    .whats-included-features__card {
      min-height: auto;
      padding: 30px 20px;
    }

    .whats-included-features__icon {
      width: 60px;
      height: 60px;
      font-size: 36px;
    }

    .whats-included-features__title {
      font-size: 16px;
    }

    .whats-included-features__description {
      font-size: 13px;
    }
  }
{%- endstyle -%}

<div class="whats-included-features">
  <div class="whats-included-features__container">
    <div class="whats-included-features__grid">
      {% for i in (1..6) %}
        {% assign icon_key = 'feature_icon_' | append: i %}
        {% assign title_key = 'feature_title_' | append: i %}
        {% assign desc_key = 'feature_description_' | append: i %}
        {% if section.settings[title_key] %}
          <div class="whats-included-features__card">
            <div class="whats-included-features__icon">{{ section.settings[icon_key] }}</div>
            <h3 class="whats-included-features__title">{{ section.settings[title_key] }}</h3>
            <p class="whats-included-features__description">{{ section.settings[desc_key] }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

