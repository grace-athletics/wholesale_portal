{%- style -%}
  .mission {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px 40px;
  }

  .mission__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 40px;
    width: 100%;
  }

  .mission__icon {
    width: 80px;
    height: 80px;
    background: #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    flex-shrink: 0;
  }

  .mission__content h3 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .mission__description {
    font-size: 16px;
    line-height: 1.6;
    color: #000;
  }

  @media (max-width: 768px) {
    .mission__container {
      flex-direction: column;
      text-align: center;
    }

    .mission__icon {
      width: 60px;
      height: 60px;
      font-size: 30px;
    }
  }
{%- endstyle -%}

<div class="mission">
  <div class="mission__container">
    <div class="mission__icon">🎯</div>
    <div class="mission__content">
      <h3>Our Mission</h3>
      <p class="mission__description">Empower entrepreneurs to create and grow innovative, custom glove brands that inspire athletes and elevate the game.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mission",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#baad8c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 150,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 150,
      "step": 10,
      "default": 60,
      "unit": "px"
    }
  ]
}
{% endschema %}
