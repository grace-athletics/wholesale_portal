{%- style -%}
  .how-it-works-timeline {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px 40px;
  }

  .how-it-works-timeline__container {
    max-width: 900px;
    margin: 0 auto;
  }

  .how-it-works-timeline__header {
    text-align: center;
    margin-bottom: 80px;
  }

  .how-it-works-timeline__subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .how-it-works-timeline__title {
    font-size: 48px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    line-height: 1.2;
  }

  .how-it-works-timeline__title:after {
    content: "";
    display: block;
    width: 60px;
    height: 2px;
    background: {{ section.settings.accent_color }};
    margin: 30px auto 0;
  }

  .how-it-works-timeline__steps {
    position: relative;
  }

  .how-it-works-timeline__steps:before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #ddd;
    transform: translateX(-50%);
  }

  .how-it-works-timeline__step {
    margin-bottom: 60px;
    display: flex;
    gap: 40px;
    align-items: flex-start;
    position: relative;
  }

  .how-it-works-timeline__step:nth-child(odd) {
    flex-direction: row;
  }

  .how-it-works-timeline__step:nth-child(even) {
    flex-direction: row-reverse;
  }

  .how-it-works-timeline__step-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #f9f9f9;
    padding: 30px 35px;
    border-radius: 8px;
    max-width: 400px;
  }

  .how-it-works-timeline__step:nth-child(odd) .how-it-works-timeline__step-content {
    text-align: right;
    align-items: flex-end;
    margin-right: 20px;
  }

  .how-it-works-timeline__step:nth-child(even) .how-it-works-timeline__step-content {
    text-align: left;
    align-items: flex-start;
    margin-left: 20px;
  }

  .how-it-works-timeline__step-number {
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
  }

  .how-it-works-timeline__step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    background: {{ section.settings.badge_background }};
    border-radius: 50%;
    color: {{ section.settings.badge_text_color }};
    font-weight: 700;
    font-size: 12px;
    text-align: center;
    padding: 5px;
  }

  .how-it-works-timeline__step-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    background: {{ section.settings.badge_background }};
    border: 3px solid {{ section.settings.background_color }};
    border-radius: 50%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  .how-it-works-timeline__step-title {
    font-size: 20px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 12px;
  }

  .how-it-works-timeline__step-description {
    font-size: 14px;
    line-height: 1.6;
    color: #666666;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .how-it-works-timeline__steps:before {
      left: 35px;
    }

    .how-it-works-timeline__step {
      flex-direction: column !important;
      gap: 20px;
      margin-bottom: 50px;
    }

    .how-it-works-timeline__step-content {
      text-align: left !important;
      align-items: flex-start !important;
      padding-left: 100px;
      margin-left: 0 !important;
      margin-right: 0 !important;
      max-width: 100%;
    }

    .how-it-works-timeline__step-number {
      position: absolute;
      left: 0;
      top: 0;
    }

    .how-it-works-timeline__step-badge {
      width: 60px;
      height: 60px;
      font-size: 11px;
    }

    .how-it-works-timeline__title {
      font-size: 36px;
    }

    .how-it-works-timeline__step-description {
      max-width: 100%;
    }
  }
{%- endstyle -%}

<div class="how-it-works-timeline">
  <div class="how-it-works-timeline__container">
    <div class="how-it-works-timeline__header">
      <div class="how-it-works-timeline__subtitle">{{ section.settings.subtitle }}</div>
      <h2 class="how-it-works-timeline__title">{{ section.settings.title }}</h2>
    </div>

    <div class="how-it-works-timeline__steps">
      {% for i in (1..5) %}
        {% assign step_title = 'step_title_' | append: i %}
        {% assign step_desc = 'step_description_' | append: i %}
        {% if section.settings[step_title] %}
          <div class="how-it-works-timeline__step">
            <div class="how-it-works-timeline__step-content">
              <h3 class="how-it-works-timeline__step-title">{{ section.settings[step_title] }}</h3>
              <p class="how-it-works-timeline__step-description">{{ section.settings[step_desc] }}</p>
            </div>
            <div class="how-it-works-timeline__step-number">
              <div class="how-it-works-timeline__step-badge">STEP {{ i }}</div>
              <div class="how-it-works-timeline__step-dot"></div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works Timeline",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "It's Really This Simple"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Launching A Glove Brand Has Never Been Easier"
    },
    {
      "type": "text",
      "id": "step_title_1",
      "label": "Step 1 Title",
      "default": "Submit Form"
    },
    {
      "type": "textarea",
      "id": "step_description_1",
      "label": "Step 1 Description",
      "default": "Fill out our form under the \"Get Started\" tab, then we will reach out to you directly to discuss your business. We'll assess where you are and determine the best path forward, including strategy and investment options."
    },
    {
      "type": "text",
      "id": "step_title_2",
      "label": "Step 2 Title",
      "default": "Onboarding"
    },
    {
      "type": "textarea",
      "id": "step_description_2",
      "label": "Step 2 Description",
      "default": "Once you decide to work with us, our development team will start building your custom glove builder on your site. You'll also have a detailed marketing strategy session with our team to set you up for success."
    },
    {
      "type": "text",
      "id": "step_title_3",
      "label": "Step 3 Title",
      "default": "Fulfillment"
    },
    {
      "type": "textarea",
      "id": "step_description_3",
      "label": "Step 3 Description",
      "default": "We'll guide you through the fulfillment process, making it easy for you. Your main focus will be on marketing and selling—fulfillment is completely hands-off for you."
    },
    {
      "type": "text",
      "id": "step_title_4",
      "label": "Step 4 Title",
      "default": "Launch"
    },
    {
      "type": "textarea",
      "id": "step_description_4",
      "label": "Step 4 Description",
      "default": "Once everything is in place and our marketing team approves your strategy, it's time to go live! We'll be there every step of the way to ensure your launch is successful."
    },
    {
      "type": "text",
      "id": "step_title_5",
      "label": "Step 5 Title",
      "default": "Scale"
    },
    {
      "type": "textarea",
      "id": "step_description_5",
      "label": "Step 5 Description",
      "default": "To help you grow, we'll meet with you one-on-one every month to review your performance and provide support where needed. We're invested in your success."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#baad8c"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#baad8c"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Step Badge Background",
      "default": "#baad8c"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Step Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "step_description_color",
      "label": "Step Description Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 150,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 150,
      "step": 10,
      "default": 80,
      "unit": "px"
    }
  ]
}
{% endschema %}
