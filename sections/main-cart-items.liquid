{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                  {%- assign is_child_item = false -%}
                  {%- assign association_key = '' -%}
                  
                  {%- comment -%} Check if this is a parent item {%- endcomment -%}
                  {%- for property in item.properties -%}
                    {%- if property.first == '_AssociationKey' -%}
                      {%- assign association_key = property.last -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  
                  {%- comment -%} Check if this is a child item {%- endcomment -%}
                  {%- if association_key == '' -%}
                    {%- for property in item.properties -%}
                      {%- if property.first == '_ParentKey' -%}
                        {%- assign is_child_item = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  
                  {%- comment -%} Calculate combined total for parent items {%- endcomment -%}
                  {%- assign combined_line_price = item.final_line_price -%}
                  {%- assign combined_original_line_price = item.original_line_price -%}
                  {%- if association_key != '' -%}
                    {%- for child_item in cart.items -%}
                      {%- for child_property in child_item.properties -%}
                        {%- if child_property.first == '_ParentKey' and child_property.last == association_key -%}
                          {%- assign combined_line_price = combined_line_price | plus: child_item.final_line_price -%}
                          {%- assign combined_original_line_price = combined_original_line_price | plus: child_item.original_line_price -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  {%- endif -%}
                  
                  {%- comment -%} Hide child items {%- endcomment -%}
                  {%- if is_child_item == false -%}
                  <tr
                    class="cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                    {% if association_key != '' %}
                      data-parent-key="{{ association_key }}"
                    {% endif %}
                  >
                    <td class="cart-item__media">
                      {%- assign vu_thumb = item.properties['_thumbnail'] | strip -%}
                      {% if vu_thumb != blank or item.image %}
                        {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                        <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        <div class="cart-item__image-container gradient {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                          {%- if vu_thumb != blank -%}
                            <img
                              class="cart-item__image animate--scale-up {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                              src="{{ vu_thumb }}"
                              alt="{{ item.image.alt | default: item.product.title | escape }}"
                              loading="lazy"
                              width="150"
                              height="150"
                              style="object-fit: cover; object-position: center; width: 100%; height: 100%; aspect-ratio: 1;"
                            >
                          {%- else -%}
                            <img
                              src="{{ item.image | image_url: width: 300 }}"
                              class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {%- endif -%}
                        </div>
                      {% endif %}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div class="product-option">
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

                          {%- assign property_size = item.properties | size -%}
                          {%- if property_size > 0 -%}
                            {%- comment -%} Define the order of properties (normalized - spaces, no underscores) {%- endcomment -%}
                            {%- assign property_order = 'Personalization 1,Personalization 2,Player Age,what sport do you play,Throwing Hand,Web Style,Add a Finger Pad or Finger Hood,Lining,Pinky 1,Pinky 2,Pinky 3,Ring 1,Ring 2,Middle 1,Middle 2,Middle 3,Index,Finger Shell,Thumb 1,Thumb 2,Web,Wrist,Bindings,Palm,Laces,Welting,Stitching,Wrist Logo Base,Wrist Logo Outline,Thumb Logo Base,Thumb Logo Outline,Thumb Logo,Thumb Number,Thumb Number Font,Thumb Number Color Fill,Number,Number Font,Number Outline,Number Fill,Add Thumb Name,Thumb Name,Thumb Name Font,Thumb Name Color Fill,Add Flag,Flag Location,Flags' | split: ',' -%}
                            
                            {%- comment -%} Track which properties have been displayed using comma-separated string {%- endcomment -%}
                            {%- assign displayed_properties = ',' -%}
                            
                            {%- comment -%} Display properties in order {%- endcomment -%}
                            {%- for ordered_key in property_order -%}
                              {%- for p in item.properties -%}
                                {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
                                {%- if p.last != blank and first_character_in_key != '_' -%}
                                  {%- assign normalized_key = p.first | replace: '_', ' ' -%}
                                  {%- assign normalized_key_lower = normalized_key | downcase -%}
                                  {%- comment -%} Skip CUSTOMF, Recipeid, and duplicate leather type properties {%- endcomment -%}
                                  {%- assign skip_property = false -%}
                                  {%- if normalized_key_lower == 'customf' or normalized_key_lower == 'recipeid' -%}
                                    {%- assign skip_property = true -%}
                                  {%- elsif normalized_key_lower == 'leather type' or normalized_key_lower == 'leather_type' -%}
                                    {%- comment -%} Only show Personalization 1 as Leather Type, skip other leather type properties {%- endcomment -%}
                                    {%- unless p.first == 'Personalization_1' or p.first == 'Personalization 1' -%}
                                      {%- assign skip_property = true -%}
                                    {%- endunless -%}
                                  {%- endif -%}
                                  {%- unless skip_property -%}
                                    {%- assign ordered_key_lower = ordered_key | downcase -%}
                                    {%- if normalized_key_lower == ordered_key_lower -%}
                                      {%- assign property_key = normalized_key -%}
                                      {%- comment -%} Capitalize first letter of each word {%- endcomment -%}
                                      {%- assign property_key_parts = property_key | split: ' ' -%}
                                      {%- assign property_key_formatted = '' -%}
                                      {%- for part in property_key_parts -%}
                                        {%- assign part_capitalized = part | capitalize -%}
                                        {%- if property_key_formatted == '' -%}
                                          {%- assign property_key_formatted = part_capitalized -%}
                                        {%- else -%}
                                          {%- assign property_key_formatted = property_key_formatted | append: ' ' | append: part_capitalized -%}
                                        {%- endif -%}
                                      {%- endfor -%}
                                      {%- assign property_key = property_key_formatted -%}
                                      {%- if normalized_key_lower == 'personalization 1' -%}
                                        {%- assign property_key = 'Leather Type' -%}
                                      {%- elsif normalized_key_lower == 'personalization 2' -%}
                                        {%- assign property_key = 'Add Flag?' -%}
                                      {%- elsif normalized_key_lower == 'what sport do you play' -%}
                                        {%- assign property_key = 'Sport' -%}
                                      {%- endif -%}
                                      
                                      {%- comment -%} Skip subcategories here, handle them separately {%- endcomment -%}
                                      {%- assign skip_subcats = false -%}
                                      {%- if ordered_key_lower == 'number font' or ordered_key_lower == 'number outline' or ordered_key_lower == 'number fill' or ordered_key_lower == 'thumb name font' or ordered_key_lower == 'thumb name fill' or ordered_key_lower == 'thumb name color fill' or ordered_key_lower == 'thumb number font' or ordered_key_lower == 'thumb number color fill' or ordered_key_lower == 'thumb number color outline' -%}
                                        {%- assign skip_subcats = true -%}
                                      {%- endif -%}
                                      {%- unless skip_subcats -%}
                                        <div class="product-option">
                                          <dt>{{ property_key }}:</dt>
                                          <dd>
                                            {%- if p.last contains '/uploads/' -%}
                                              {%- assign file_name = p.last | split: '/' | last | replace: '_', ' ' -%}
                                              {%- if file_name contains ' ' -%}
                                                {%- assign file_parts = file_name | split: ' ' -%}
                                                {%- assign first_part = file_parts[0] -%}
                                                {%- assign last_part = file_parts[1] -%}
                                                {%- if first_part contains '0' or first_part contains '1' or first_part contains '2' or first_part contains '3' or first_part contains '4' or first_part contains '5' or first_part contains '6' or first_part contains '7' or first_part contains '8' or first_part contains '9' -%}
                                                  {%- if last_part contains '0' or last_part contains '1' or last_part contains '2' or last_part contains '3' or last_part contains '4' or last_part contains '5' or last_part contains '6' or last_part contains '7' or last_part contains '8' or last_part contains '9' -%}
                                                    {%- assign file_name = file_name | replace: ' ', '.' -%}
                                                  {%- endif -%}
                                                {%- endif -%}
                                              {%- endif -%}
                                              <a href="{{ p.last }}" class="link" target="_blank">{{ file_name }}</a>
                                            {%- else -%}
                                              {%- if p.first == "Configuration Link" -%}
                                                <a href="https://{{p.last}}" style="text-decoration: underline">Change chosen options</a>
                                              {%- else -%}
                                                {%- assign property_value = p.last | replace: '_', ' ' -%}
                                                {%- if property_value contains ' ' -%}
                                                  {%- assign property_parts = property_value | split: ' ' -%}
                                                  {%- assign first_part = property_parts[0] -%}
                                                  {%- assign last_part = property_parts[1] -%}
                                                  {%- if first_part contains '0' or first_part contains '1' or first_part contains '2' or first_part contains '3' or first_part contains '4' or first_part contains '5' or first_part contains '6' or first_part contains '7' or first_part contains '8' or first_part contains '9' -%}
                                                    {%- if last_part contains '0' or last_part contains '1' or last_part contains '2' or last_part contains '3' or last_part contains '4' or last_part contains '5' or last_part contains '6' or last_part contains '7' or last_part contains '8' or last_part contains '9' -%}
                                                      {%- assign property_value = property_value | replace: ' ', '.' -%}
                                                    {%- endif -%}
                                                  {%- endif -%}
                                                {%- endif -%}
                                                {{ property_value }}
                                              {%- endif -%}
                                            {%- endif -%}
                                          </dd>
                                        </div>
                                        
                                        {%- assign displayed_properties = displayed_properties | append: p.first | append: ',' -%}
                                        
                                        {%- comment -%} Handle Number subcategories {%- endcomment -%}
                                        {%- assign ordered_key_lower_check = ordered_key | downcase -%}
                                        {%- if ordered_key_lower_check == 'number' -%}
                                          {%- for sub_p in item.properties -%}
                                            {%- assign sub_normalized = sub_p.first | replace: '_', ' ' -%}
                                            {%- assign sub_normalized_lower = sub_normalized | downcase -%}
                                            {%- if sub_normalized_lower == 'number font' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Font:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- elsif sub_normalized_lower == 'number outline' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Outline:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- elsif sub_normalized_lower == 'number fill' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Fill:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- endif -%}
                                          {%- endfor -%}
                                        {%- endif -%}
                                        
                                        {%- comment -%} Handle Thumb Number subcategories {%- endcomment -%}
                                        {%- if ordered_key_lower_check == 'thumb number' -%}
                                          {%- for sub_p in item.properties -%}
                                            {%- assign sub_normalized = sub_p.first | replace: '_', ' ' -%}
                                            {%- assign sub_normalized_lower = sub_normalized | downcase -%}
                                            {%- if sub_normalized_lower == 'thumb number font' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Font:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- elsif sub_normalized_lower == 'thumb number color fill' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Fill:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- elsif sub_normalized_lower == 'thumb number color outline' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Outline:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- endif -%}
                                          {%- endfor -%}
                                        {%- endif -%}
                                        
                                        {%- comment -%} Handle Thumb Name subcategories {%- endcomment -%}
                                        {%- if ordered_key_lower_check == 'thumb name' -%}
                                          {%- for sub_p in item.properties -%}
                                            {%- assign sub_normalized = sub_p.first | replace: '_', ' ' -%}
                                            {%- assign sub_normalized_lower = sub_normalized | downcase -%}
                                            {%- if sub_normalized_lower == 'thumb name font' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Font:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- elsif sub_normalized_lower == 'thumb name fill' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Fill:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- elsif sub_normalized_lower == 'thumb name color fill' and sub_p.last != blank -%}
                                              <div class="product-option" style="padding-left: 20px;">
                                                <dt>Fill:</dt>
                                                <dd>{{ sub_p.last | replace: '_', ' ' }}</dd>
                                              </div>
                                              {%- assign displayed_properties = displayed_properties | append: sub_p.first | append: ',' -%}
                                            {%- endif -%}
                                          {%- endfor -%}
                                        {%- endif -%}
                                      {%- endunless -%}
                                      {%- break -%}
                                    {%- endif -%}
                                  {%- endunless -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endfor -%}
                            
                            {%- comment -%} Display any remaining properties not in the ordered list {%- endcomment -%}
                            {%- for p in item.properties -%}
                              {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
                              {%- unless p.last == blank or first_character_in_key == '_' -%}
                                {%- assign normalized_key_check = p.first | replace: '_', ' ' | downcase -%}
                                {%- comment -%} Skip CUSTOMF, Recipeid, and duplicate leather type properties {%- endcomment -%}
                                {%- assign skip_property_check = false -%}
                                {%- if normalized_key_check == 'customf' or normalized_key_check == 'recipeid' -%}
                                  {%- assign skip_property_check = true -%}
                                {%- elsif normalized_key_check == 'leather type' or normalized_key_check == 'leather_type' -%}
                                  {%- comment -%} Only show Personalization 1 as Leather Type, skip other leather type properties {%- endcomment -%}
                                  {%- unless p.first == 'Personalization_1' or p.first == 'Personalization 1' -%}
                                    {%- assign skip_property_check = true -%}
                                  {%- endunless -%}
                                {%- endif -%}
                                {%- unless skip_property_check -%}
                                  {%- assign check_key = ',' | append: p.first | append: ',' -%}
                                  {%- unless displayed_properties contains check_key -%}
                                    {%- assign property_key = p.first | replace: '_', ' ' -%}
                                    {%- assign property_key_lower = property_key | downcase -%}
                                    {%- comment -%} Capitalize first letter of each word {%- endcomment -%}
                                    {%- assign property_key_parts = property_key | split: ' ' -%}
                                    {%- assign property_key_formatted = '' -%}
                                    {%- for part in property_key_parts -%}
                                      {%- assign part_capitalized = part | capitalize -%}
                                      {%- if property_key_formatted == '' -%}
                                        {%- assign property_key_formatted = part_capitalized -%}
                                      {%- else -%}
                                        {%- assign property_key_formatted = property_key_formatted | append: ' ' | append: part_capitalized -%}
                                      {%- endif -%}
                                    {%- endfor -%}
                                    {%- assign property_key = property_key_formatted -%}
                                    {%- if property_key_lower == 'personalization 1' -%}
                                      {%- assign property_key = 'Leather Type' -%}
                                    {%- elsif property_key_lower == 'personalization 2' -%}
                                      {%- assign property_key = 'Add Flag?' -%}
                                    {%- elsif property_key_lower == 'what sport do you play' -%}
                                      {%- assign property_key = 'Sport' -%}
                                    {%- endif -%}
                                    <div class="product-option">
                                      <dt>{{ property_key }}:</dt>
                                      <dd>
                                        {%- if p.last contains '/uploads/' -%}
                                          {%- assign file_name = p.last | split: '/' | last | replace: '_', ' ' -%}
                                          {%- if file_name contains ' ' -%}
                                            {%- assign file_parts = file_name | split: ' ' -%}
                                            {%- assign first_part = file_parts[0] -%}
                                            {%- assign last_part = file_parts[1] -%}
                                            {%- if first_part contains '0' or first_part contains '1' or first_part contains '2' or first_part contains '3' or first_part contains '4' or first_part contains '5' or first_part contains '6' or first_part contains '7' or first_part contains '8' or first_part contains '9' -%}
                                              {%- if last_part contains '0' or last_part contains '1' or last_part contains '2' or last_part contains '3' or last_part contains '4' or last_part contains '5' or last_part contains '6' or last_part contains '7' or last_part contains '8' or last_part contains '9' -%}
                                                {%- assign file_name = file_name | replace: ' ', '.' -%}
                                              {%- endif -%}
                                            {%- endif -%}
                                          {%- endif -%}
                                          <a href="{{ p.last }}" class="link" target="_blank">{{ file_name }}</a>
                                        {%- else -%}
                                          {%- if p.first == "Configuration Link" -%}
                                            <a href="https://{{p.last}}" style="text-decoration: underline">Change chosen options</a>
                                          {%- else -%}
                                            {%- assign property_value = p.last | replace: '_', ' ' -%}
                                            {%- if property_value contains ' ' -%}
                                              {%- assign property_parts = property_value | split: ' ' -%}
                                              {%- assign first_part = property_parts[0] -%}
                                              {%- assign last_part = property_parts[1] -%}
                                              {%- if first_part contains '0' or first_part contains '1' or first_part contains '2' or first_part contains '3' or first_part contains '4' or first_part contains '5' or first_part contains '6' or first_part contains '7' or first_part contains '8' or first_part contains '9' -%}
                                                {%- if last_part contains '0' or last_part contains '1' or last_part contains '2' or last_part contains '3' or last_part contains '4' or last_part contains '5' or last_part contains '6' or last_part contains '7' or last_part contains '8' or last_part contains '9' -%}
                                                  {%- assign property_value = property_value | replace: ' ', '.' -%}
                                                {%- endif -%}
                                              {%- endif -%}
                                            {%- endif -%}
                                            {{ property_value }}
                                          {%- endif -%}
                                        {%- endif -%}
                                      </dd>
                                    </div>
                                  {%- endunless -%}
                                {%- endunless -%}
                              {%- endunless -%}
                            {%- endfor -%}
                          {%- endif -%}
                        </dl>

                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if combined_original_line_price != combined_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ combined_original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ combined_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ combined_original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              {% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            {% if association_key != '' %}
                              data-parent-key="{{ association_key }}"
                              data-is-parent="true"
                            {% endif %}
                            {% assign can_remove = item.instructions.can_remove | default: true %}
                            {% if can_remove == false %}
                              class="hidden"
                            {% endif %}
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if combined_original_line_price != combined_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ combined_original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ combined_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ combined_original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                  </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
