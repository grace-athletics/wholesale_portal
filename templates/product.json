        "collapsible_row_xz3idd": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What all do I get once I become a member?",
            "icon": "none",
            "row_content": "<ul><li>Unlock wholesale pricing</li><li>Place orders through our Blank Builder </li><li>Gain access to a private Slack channel with Kevin and Michael, the founders of My Glove Brand, for 24/7 support. </li><li>You’ll also receive exclusive marketing resources and consulting to help you sell your gloves.</li></ul>",
