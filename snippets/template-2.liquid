<script>
  const params = new URLSearchParams(window.location.search);
  const productId = params.get("product"); // or "variant" or whatever param you use
  const recipeId = params.get("recipe_id");
  if (productId) {
    let variant;
    if(productId === 'fielders'){
        variant = '{{ section.settings.proKipFieldersId }}'
    } else if(productId === 'catchers'){
        variant = '{{ section.settings.proKipCatchersId }}'
    } else if(productId === 'firstBase'){
        variant = '{{ section.settings.proKipFirstBaseId }}'
    } else if(productId === 'japanKip'){
        variant = '{{ section.settings.japanKipUpliftId }}'
    } else if(productId === 'flag'){
        variant = '{{ section.settings.flagUpliftId }}'
    }
    const script = document.createElement("script");
    script.id = "customizer";
    script.src = "https://vu-customizer.s3.amazonaws.com/production/vu_customizer.js";
    script.setAttribute("data-variant", variant);
    script.setAttribute("data-status", "draft");
    script.setAttribute("data-uplift-japan-kip", '{{ section.settings.japanKipUpliftId }}');
    script.setAttribute("data-uplift-flag", '{{ section.settings.flagUpliftId }}');
    if(recipeId){
        script.setAttribute("data-recipe-id", recipeId);
    }
    
    script.defer = true;
    document.body.appendChild(script);
    document.addEventListener('DOMContentLoaded', function () {
      const modal = document.getElementById('customizer-modal');
        modal.classList.remove('customizer-hidden');
        document.body.style.overflow = 'hidden'; // Prevent scrolling when modal is open
    });
  }
</script>
{% comment %} <script id="customizer" src="https://vu-customizer.s3.amazonaws.com/production/vu_customizer.js" data-variant="{{ customizer_id }}" data-status="draft" defer></script> {% endcomment %}

<script>


  document.addEventListener('DOMContentLoaded', function () {
      let sceneRenderedFlag = false;

      // Listen for the scene rendered event and update the flag.
      document.addEventListener('customizer.scene-rendered', function () {
          sceneRenderedFlag = true;
      }, { once: true });

      const vuCustomizerBtn = document.getElementById('vu-customizer-btn');
      if (vuCustomizerBtn) {
          vuCustomizerBtn.addEventListener('click', function () {
              openPopUpModal();
          });
      }

      const openButton = document.getElementById('open-customizer-button');
      const modal = document.getElementById('customizer-modal');
      const loadingModal = document.querySelector('.loading-vu-modal');

      // Shows loading screen when customizer is initializing
      function openLoadingModal() {
          loadingModal.classList.add('active');
          document.body.style.overflow = 'hidden';
      }

      // Hides loading screen when initialization completes
      function closeLoadingModal() {
          loadingModal.classList.remove('active');
      }

      // Displays error message when loading fails after timeout
      function ErrorModal() {
          document.querySelector('.loading-gif').style.display = 'none';
          document.querySelector('.loading-assets').style.display = 'none';
          document.querySelector('.vu-failed-loading').classList.add('active');
      }

      // Shows main customizer interface after loading completes
      function openModal() {
          closeLoadingModal();
          modal.classList.remove('customizer-hidden');
          document.body.style.overflow = 'hidden';
      }

      // Handles keyboard focus trapping within the active tab
      function callTrapOnSelectedTab() {
          // Implementation can be added if needed
      }

      // Main entry point for opening customizer with loading state management
      function openPopUpModal() {
          if (sceneRenderedFlag) {
              openModal();
              callTrapOnSelectedTab();
          } else {
              openLoadingModal();
              // The scene hasn't rendered yet, so let's listen for the event.
              document.addEventListener('customizer.scene-rendered', function () {
                  openModal();
              }, { once: true });


              setTimeout(function () {
                  if (!sceneRenderedFlag) {
                      ErrorModal();
                  }
              }, 40000);
          }
      }

      // Open modal when button is clicked
      openButton?.addEventListener('click', function () {
          openPopUpModal();
      });

      // Close loading modal when close button is clicked
      document.querySelector('.close-loading').addEventListener('click', function () {
          closeLoadingModal();
          document.body.style.overflow = '';
      });

      // Listen for the customizer.scene-rendered event
      document.addEventListener('customizer.scene-rendered', function () {
          // Create and append the Preview tab to be the last one
          const tabContainer = document.getElementById('customizer-tab-container');
          if (tabContainer) {
              const previewTab = document.createElement('div');
              previewTab.className = 'customizer-tab';
              previewTab.id = 'customizer-preview-tab';
              
              const tabNameDiv = document.createElement('div');
              tabNameDiv.className = 'customizer-tab-name';
              tabNameDiv.textContent = 'Your Specs';

              const shareButton = document.getElementById('customizer-share-button');
              if (shareButton) {
                  tabNameDiv.appendChild(shareButton);
              }
              
              previewTab.appendChild(tabNameDiv);
              tabContainer.appendChild(previewTab);

              // Move the preview tab body to the end of the container
              const tabBodyContainer = document.getElementById('customizer-tab-body-container');
              const previewTabBody = document.getElementById('customizer-tab-body-preview');
              if (tabBodyContainer && previewTabBody) {
                  tabBodyContainer.appendChild(previewTabBody);
                  previewTabBody.classList.add('vu-main-hidden');
              }
          }
          // ...other setup...
          const closeButton = document.getElementById('close');
          if (closeButton) {
              closeButton.addEventListener('click', function () {
                  modal.classList.add('customizer-hidden');
                  document.body.style.overflow = '';
              });
          }

          // Initialize progress bar
          const progressBar = document.getElementById('customizer-progress-bar');
          const progressContainer = document.querySelector('.progress-bar-container');

          if (progressBar && progressContainer) {
              // Wait for tabs to be fully loaded before showing progress bar
              setTimeout(() => {
                  const selectedTab = document.querySelector('.customizer-tab-selected');
                  if (selectedTab) {
                      const tabs = Array.from(document.querySelectorAll('.customizer-tab'));
                      const idx = tabs.indexOf(selectedTab);
                      if (idx !== -1) {
                          // Set width first while still hidden
                          progressBar.style.transition = 'none';
                          const progress = ((idx + 1) / tabs.length) * 100;
                          progressBar.style.width = progress + '%';

                          // Show progress bar after width is set and tab counter is visible
                          setTimeout(() => {
                              progressBar.style.transition = 'width 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease';
                              progressContainer.classList.remove('progress-hidden');
                          }, 300);
                      }
                  }
              }, 600); // Increased delay to ensure tabs and counter are fully loaded
          }

          setupSavedItems();
          setupShareAndReset();
          setupTabNavigation();
          setupMobileResize();
          setupResetView();
          setupSpinnerDrag();
      });

      // Configures share functionality and reset button behavior
      function setupShareAndReset() {
          const shareLinkModal = document.querySelector('#share-link');
          const overlayPopup = document.querySelector('#overlay-popup');
          const startOverConfirm = document.querySelector('.start-over-confirm');
          const resetButton = document.getElementById('customizer-reset-button');
          const copyButton = document.getElementById('copy-button');

          // Setup reset button functionality
          if (resetButton) {
              resetButton.addEventListener('click', function () {
                  if (window.customizer && window.customizer.recipeChanged) {
                      overlayPopup.style.display = 'block';
                      startOverConfirm.style.display = 'block';
                  } else {
                      if (window.newSplide) {
                          window.newSplide.go(0);
                      }
                      if (window.customizer) {
                          window.customizer.reset();
                          document.dispatchEvent(new CustomEvent('vu-reset-tabs'));
                      }
                  }
              });
          }

          // Setup start confirmation
          const startConfirm = document.getElementById('start-confirm');
          if (startConfirm) {
              startConfirm.addEventListener('click', function () {
                  overlayPopup.style.display = 'none';
                  startOverConfirm.style.display = 'none';
                  if (window.newSplide) {
                      window.newSplide.go(0);
                  }
                  if (window.customizer) {
                      window.customizer.reset();
                  
                      document.dispatchEvent(new CustomEvent('vu-reset-tabs', { detail: { animateProgressBar: false } }));
                  }

                  // Reset progress bar to first step
                  const progressBar = document.getElementById('customizer-progress-bar');
                  const progressContainer = document.querySelector('.progress-bar-container');

                  if (progressBar && progressContainer) {
                      // Hide progress container
                      progressContainer.classList.add('progress-hidden');

                      // Reset width after a short delay
                      setTimeout(() => {
                          progressBar.style.transition = 'none';
                          progressBar.style.width = (100 / document.querySelectorAll('.customizer-tab').length) + '%';

                          // Show progress bar again with transition
                          setTimeout(() => {
                              progressBar.style.transition = 'width 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease';
                              progressContainer.classList.remove('progress-hidden');
                          }, 50);
                      }, 300);
                  }
              });
          }

          // Closes overlay popup and resets UI state
          function closeOverlayPopup() {
              overlayPopup.style.display = 'none';
              if (startOverConfirm) {
                  startOverConfirm.style.display = 'none';
              }
              if (shareLinkModal) {
                  shareLinkModal.style.display = 'none';
              }
          }

          // Setup share event listener
          document.addEventListener('customizer.shared', function (event) {
              if (shareLinkModal && overlayPopup) {
                  shareLinkModal.style.display = 'flex';
                  overlayPopup.style.display = 'block';
              }
          });

          // Setup click handlers for closing elements
          if (overlayPopup) {
              overlayPopup.addEventListener('click', closeOverlayPopup);
          }

          const shareClosed = document.getElementById('share-closed');
          if (shareClosed) {
              shareClosed.addEventListener('click', closeOverlayPopup);
          }

          const resetClosed = document.getElementById('reset-closed');
          if (resetClosed) {
              resetClosed.addEventListener('click', closeOverlayPopup);
          }

          const closeConfirm = document.getElementById('close-confirm');
          if (closeConfirm) {
              closeConfirm.addEventListener('click', closeOverlayPopup);
          }

          // Setup copy button functionality
          if (copyButton) {
              copyButton.addEventListener('click', async () => {
                  const shareLink = document.getElementById('customizer-share-link').textContent;
                  await navigator.clipboard.writeText(shareLink);
                  copyButton.textContent = 'COPIED!';
                  setTimeout(() => copyButton.textContent = 'COPY', 2000);
              });
          }
      }

      // Manages saved customizations display and interactions
      function setupSavedItems() {
          // Get the elements by their class names
          const customizerSavedItemCount = document.getElementById('customizer-saved-item-count');
          const savedInfoClosed = document.querySelector('.saved-info-closed');
          const wrapperSaved = document.querySelector('.wrapper-saved');

          if (savedInfoClosed && wrapperSaved) {
              savedInfoClosed.addEventListener('click', function () {
                  // Hide the wrapper-saved element with a 0.3-second transition
                  wrapperSaved.style.transition = 'opacity 0.3s, transform 0.3s'; // Add transition properties
                  wrapperSaved.style.opacity = '0'; // Fade out by changing opacity to 0
                  wrapperSaved.style.transform = 'scale(0)'; // Scale down to 0
                  setTimeout(function () {
                      wrapperSaved.style.display = 'none'; // Hide the element after the transition is complete
                  }, 300); // Adjust the delay to match the transition duration
              });
          }

          if (customizerSavedItemCount && wrapperSaved) {
              customizerSavedItemCount.addEventListener('click', function () {
                  // Show the wrapper-saved element with a 0.3-second transition
                  wrapperSaved.style.transition = 'opacity 0.3s, transform 0.3s'; // Add transition properties
                  wrapperSaved.style.display = 'block'; // Show the element
                  setTimeout(function () {
                      wrapperSaved.style.opacity = '1'; // Fade in by changing opacity to 1
                      wrapperSaved.style.transform = 'scale(1)'; // Scale up to 1
                  }, 0); // Use a minimal delay (0ms) to trigger the transition immediately
              });
          }
      }

      // Toggles body scroll lock for modal interactions
      function lockBody() {
          document.body.style.overflow = document.body.style.overflow === 'hidden' ? '' : 'hidden';
      }

      // Handles tab switching, progress display, and navigation
      function setupTabNavigation() {
          const tabContainer = document.getElementById('customizer-tab-container');
          const tabs = Array.from(tabContainer.querySelectorAll('.customizer-tab'));
          const prevBtn = document.getElementById('customizer-tab-prev');
          const nextBtn = document.getElementById('customizer-tab-next');
          const counter = document.getElementById('customizer-tab-counter');
          const currentNameContainer = document.getElementById('customizer-tab-current-name');
          const atcButton = document.querySelector('.wrapper-bottom-nav .customizer-add-to-cart-button');
          const progressBar = document.getElementById('customizer-progress-bar');

          if (atcButton) {
              atcButton.addEventListener('click', function () {
                  var cartUrl = (typeof window.routes !== 'undefined' && window.routes.cart_url) ? window.routes.cart_url : '/cart';
                  fetch('/cart.js').then(function (r) { return r.json(); }).then(function (initial) {
                      var initialCount = initial.item_count || 0;
                      var pollStart = Date.now();
                      var maxWait = 15000;
                      var poll = function () {
                          if (Date.now() - pollStart > maxWait) return;
                          fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
                              var count = cart.item_count || 0;
                              if (count > initialCount) {
                                  window.location.href = cartUrl;
                                  return;
                              }
                              setTimeout(poll, 500);
                          }).catch(function () { setTimeout(poll, 500); });
                      };
                      setTimeout(poll, 800);
                  });
              });
          }

          // Initialize progress bar to 0% to prevent flashing to 100%
          if (progressBar) {
              progressBar.style.width = '0%';
          }

          // Add numbered classes to tabs
          tabs.forEach((tab, index) => {
              tab.classList.add(`customizer-tab-${index + 1}`);
          });

          // Returns the index of the currently selected tab
          function getSelectedIndex() {
              return tabs.findIndex(tab => tab.classList.contains('customizer-tab-selected'));
          }

          // Updates the step counter display with animation
          function updateCounter() {
              const idx = getSelectedIndex();
              // Trigger CSS animation by temporarily removing and re-adding
              counter.style.animation = 'none';
              counter.offsetHeight; // Trigger reflow
              counter.style.animation = 'fadeInOut 0.6s ease-in-out';
              counter.textContent = `${idx + 1} / ${tabs.length}`;
          }

          // Updates the current tab name display in navigation
          function updateCurrentTabName(idx) {
              if (idx < 0 || idx >= tabs.length) return;
              // Move the .customizer-tab-name node to the nav
              const tabName = tabs[idx].querySelector('.customizer-tab-name');
              if (tabName && currentNameContainer) {
                  // Trigger CSS animation by temporarily removing and re-adding
                  currentNameContainer.style.animation = 'none';
                  currentNameContainer.offsetHeight; // Trigger reflow
                  currentNameContainer.style.animation = 'fadeInOut 0.6s ease-in-out';

                  currentNameContainer.innerHTML = '';
                  const newTabName = tabName.cloneNode(true);
                  currentNameContainer.appendChild(newTabName);

                  const clonedShareButton = newTabName.querySelector('#customizer-share-button');
                  if (clonedShareButton) {
                      clonedShareButton.id = 'customizer-share-button-cloned'; // Avoid duplicate IDs
                      clonedShareButton.addEventListener('click', () => {
                          const originalShareButton = document.getElementById('customizer-share-button');
                          if(originalShareButton) originalShareButton.click();
                      });
                  }
              }
          }

          // Shows/hides navigation buttons based on current tab position
          function updateNavigationButtons(idx) {
              const isLastTab = idx === tabs.length - 1;

              if (isLastTab) {
                  // Hide next button and show add to cart button on last tab
                  nextBtn.style.display = 'none';
                  if (atcButton) {
                      atcButton.style.display = 'flex';
                  }
              } else {
                  // Show next button and hide add to cart button on other tabs
                  nextBtn.style.display = 'flex';
                  if (atcButton) {
                      atcButton.style.display = 'none';
                  }
              }
          }

          // Updates the progress bar based on current tab position
          function updateProgressBar(idx) {
              const progressBar = document.getElementById('customizer-progress-bar');
              if (progressBar) {
                  // Ensure opacity is set to 1
                  progressBar.style.opacity = '1';

                  // Reset to 0 first to ensure animation works correctly
                  progressBar.style.transition = 'none';
                  progressBar.offsetHeight; // Force reflow

                  // Calculate progress based on current tab index
                  const progress = ((idx + 1) / tabs.length) * 100;

                  // Re-enable transition and set the width
                  progressBar.style.transition = 'width 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease';
                  progressBar.style.width = progress + '%';
              }
          }

          // Selects a tab and updates all UI elements accordingly
          function selectTab(idx, options = {}) {
              tabs.forEach(tab => tab.classList.remove('customizer-tab-selected'));
              tabs[idx].classList.add('customizer-tab-selected');
              updateCounter();
              updateCurrentTabName(idx);
              updateNavigationButtons(idx);
              if (!options.isReset) {
                  updateProgressBar(idx);
              }

              const isPreviewTab = tabs[idx].id === 'customizer-preview-tab';
              const tabBodyContainer = document.getElementById('customizer-tab-body-container');
              const allOriginalTabBodies = tabBodyContainer.querySelectorAll('.customizer-tab-body:not(#customizer-tab-body-preview)');
              const previewBody = document.getElementById('customizer-tab-body-preview');

              if (isPreviewTab) {
                  // When switching to the preview tab, hide all original tab bodies
                  // and show the preview body.
                  allOriginalTabBodies.forEach(body => body.classList.add('vu-main-hidden'));
                  if (previewBody) {
                      previewBody.classList.remove('vu-main-hidden');
                      previewBody.classList.remove('customizer-hidden');
                  }
              } else {
                  // When switching back to an original tab, hide the preview body.
                  if (previewBody) {
                      previewBody.classList.add('vu-main-hidden');
                  }
                  
                  // Remove our custom hidden class from all original bodies so the
                  // original script can take over.
                  allOriginalTabBodies.forEach(body => body.classList.remove('vu-main-hidden'));

                  
                  const tabName = tabs[idx].querySelector('.customizer-tab-name');
                  if (tabName) tabName.click();
              }
          }

          prevBtn.onclick = () => {
              let idx = getSelectedIndex();
              if (idx > 0) selectTab(idx - 1);
          };

          nextBtn.onclick = () => {
              let idx = getSelectedIndex();
              if (idx < tabs.length - 1) selectTab(idx + 1);
          };

          // Make tabs clickable
          tabs.forEach((tab, idx) => {
              tab.addEventListener('click', function (e) {
                  if (!tab.classList.contains('customizer-tab-selected')) {
                      selectTab(idx);
                  }
              });
          });

          // Listen for reset event to select the first tab
          document.addEventListener('vu-reset-tabs', (e) => {
              const animateProgressBar = e.detail?.animateProgressBar ?? true;
              // isReset being true will *prevent* the progress bar from animating in selectTab
              selectTab(0, { isReset: !animateProgressBar });
          });

          // Initial counter, tab name, and navigation buttons
          let initialIndex = getSelectedIndex();
          if (initialIndex === -1 && tabs.length > 0) {
              initialIndex = 0;
              tabs[initialIndex].classList.add('customizer-tab-selected');
          }

          if (initialIndex !== -1) {
              updateCounter();
              updateCurrentTabName(initialIndex);
              updateNavigationButtons(initialIndex);
              updateProgressBar(initialIndex);
          }

          // Keyboard navigation
          document.addEventListener('keydown', (e) => {
              const modal = document.getElementById('customizer-modal');
              if (modal && !modal.classList.contains('customizer-hidden')) {
                  if (e.key === 'ArrowLeft') {
                      e.preventDefault();
                      prevBtn.click();
                  } else if (e.key === 'ArrowRight') {
                      e.preventDefault();
                      nextBtn.click();
                  }
              }
          });
      }

      // Sets up the mobile resize functionality
      function setupMobileResize() {
          let isResizing = false;
          let lastDownY = 0;

          const topDiv = document.getElementById('customizer-main-perspective');
          const bottomDiv = document.querySelector('.wrapper-div');
          const handle = document.querySelector('.bottom-resizer');

          if (!topDiv || !bottomDiv || !handle) {
              return;
          }

          handle.addEventListener('mousedown', startResize);
          handle.addEventListener('touchstart', startResize, { passive: false });

          function startResize(e) {
              isResizing = true;
              lastDownY = e.clientY || e.touches[0].clientY;
              e.preventDefault();

              // Disable transitions for smooth resizing
              topDiv.style.transition = 'none';
              bottomDiv.style.transition = 'none';
          }

          document.addEventListener('mousemove', resize);
          document.addEventListener('touchmove', resize, { passive: false });

          function resize(e) {
              if (!isResizing) return;

              const clientY = e.clientY || e.touches[0].clientY;
              const deltaY = clientY - lastDownY;
              const newHeightTop = topDiv.offsetHeight + deltaY;

              if (newHeightTop > 500 || newHeightTop < 210) {
                  return;
              }

              const newHeightBottom = bottomDiv.offsetHeight - deltaY;
              topDiv.style.height = newHeightTop + 'px';
              bottomDiv.style.height = newHeightBottom + 'px';

              lastDownY = clientY;
              e.preventDefault();
          }

          document.addEventListener('mouseup', stopResize);
          document.addEventListener('touchend', stopResize);

          function stopResize() {
              if (!isResizing) return;
              isResizing = false;

              // Re-enable transitions after resizing
              topDiv.style.transition = '';
              bottomDiv.style.transition = '';
          }
      }

      function setupResetView() {
          const modal = document.getElementById('customizer-modal');
          if (modal) {
              modal.addEventListener('click', function(event) {
                  if (event.target.closest('#customizer-reset-view')) {
                      resetView();
                  }
              });
          }
      }

      function resetView() {
          console.log("resetView");
          customizer.resetPerspective(); //not working at the moment
      }

      function setupSpinnerDrag() {
        let state = { dragging: false, startX: 0, item: null };
        
        function handleEvent(e) {
            const item = e.target.closest ? e.target.closest('.list-element-spinner-item') : null;
            const clientX = e.type.includes('touch') ? (e.touches?.[0] || e.changedTouches?.[0])?.clientX : e.clientX;
            
            if (e.type.includes('down') && item?.classList.contains('customizer-selected')) {
                Object.assign(state, { dragging: true, startX: clientX, item });
                item.style.cssText += 'transition:none!important;cursor:grabbing';
                e.preventDefault();
            } else if (e.type.includes('move') && state.dragging) {
                const offset = Math.max(-25, Math.min(25, (clientX - state.startX) * 0.5));
                state.item.style.setProperty('--drag-offset', `${offset}px`);
                e.preventDefault();
            } else if ((e.type.includes('up') || e.type === 'mouseleave') && state.dragging) {
                const deltaX = (clientX || state.startX) - state.startX;
                state.item.style.removeProperty('transition');
                state.item.style.cursor = '';
                state.item.style.removeProperty('--drag-offset');
                
                if (Math.abs(deltaX) > 20) {
                    const container = state.item.closest('.list-element-spinner-container');
                    const spinner = container?.closest('.list-element-spinner');
                    const items = container.querySelectorAll('.list-element-spinner-item');
                    const currentIdx = [...items].findIndex(i => i.classList.contains('customizer-selected'));
                    const newIdx = deltaX > 0 ? currentIdx + 1 : currentIdx - 1;
                    
                    if (newIdx >= 0 && newIdx < items.length) {
                        const btn = spinner.querySelector(deltaX > 0 ? 
                            '#list-element-spinner-right, .list-element-spinner-button-right' : 
                            '#list-element-spinner-left, .list-element-spinner-button-left');
                        btn?.click();
                    }
                }
                Object.assign(state, { dragging: false, item: null });
            }
        }
        
        ['mousedown', 'touchstart', 'mousemove', 'touchmove', 'mouseup', 'touchend', 'mouseleave']
            .forEach(type => document.addEventListener(type, handleEvent, 
                type.includes('touch') ? { passive: false } : false));
      }
  });

</script>
