      gap: 5px;
      flex-direction: column;
  }
  .list-element-spinner-item{
      position: relative;
  }

  .list-element-spinner-item:after {
      content: "";
      width: 133px;
      height: 2px;
      position: absolute;
      left: 0;
      background: #000;
      top: -5px;
      transition: all .3s ease-in-out;
  }
  .list-element-spinner-container{
      transform: unset!important;
  }
  .list-element-spinner-item.customizer-selected{
      font-weight: bold;
  }
  .list-element-spinner-item.customizer-selected:before {
      content: "";
      width: 15px;
      height: 15px;
      border-radius: 50px;
      position: absolute;
      top: -12px;
      background: #000;
      left: calc(0px + var(--drag-offset, 0px));
      transition: left 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.1s ease-out;
      animation: pulse 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
      cursor: grab;
      will-change: left, transform;
  }

  .list-element-spinner-item.customizer-selected:active:before {
      cursor: grabbing;
  }

  .list-element-spinner-item.customizer-selected:hover:before {
      transform: scale(1.1);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
      transition: transform 0.1s ease-out, box-shadow 0.1s ease-out;
  }

  .list-element-spinner-item {
      cursor: pointer;
      transition: opacity 0.1s ease-out;
  }

  .list-element-spinner-item:hover:not(.customizer-selected) {
      opacity: 0.75;
  }

  .list-element-spinner-item.customizer-selected {
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
  }

  .list-element-spinner-item:last-child:after {
      display: none;
  }
  #list-element-spinner-right,
  #list-element-spinner-left{
      cursor: pointer;
      font-size: 30px;
      color: black;
  }

  @keyframes pulse {
      0% {
          transform: scale(0.9);
          opacity: 0.8;
      }
      40% {
          transform: scale(1.15);
          opacity: 1;
      }
      100% {
          transform: scale(1);
          opacity: 1;
      }
  }

