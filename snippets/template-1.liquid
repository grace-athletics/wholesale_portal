<script>
  document.addEventListener('DOMContentLoaded', function () {
      const openButton = document.getElementById('open-customizer-button');
      const modal = document.getElementById('customizer-modal');

      // Function to open the modal
      function openPopUpModal() {
          modal.classList.remove('customizer-hidden');
          document.body.style.overflow = 'hidden'; // Prevent scrolling when modal is open
      }

      // Check if the URL contains 'recipe_id'
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('recipe_id')) {
          openPopUpModal();
      }

      // Open modal when button is clicked
      openButton?.addEventListener('click', function () {
          openPopUpModal();
      });


      // Listen for the customizer.scene-rendered event
      document.addEventListener('customizer.scene-rendered', function () {
          // ...other setup...
          const closeButton = document.getElementById('close');
          if (closeButton) {
              closeButton.addEventListener('click', function () {
                  modal.classList.add('customizer-hidden');
                  document.body.style.overflow = '';
              });
          }
          closeOptions();
          closeSummary();
          setupViewSpecs();
          setupSavedItems();
          setupShareAndReset();
          setupTabNavigation();
      });

      function setupShareAndReset() {
          const shareLinkModal = document.querySelector('#share-link');
          const overlayPopup = document.querySelector('#overlay-popup');
          const startOverConfirm = document.querySelector('.start-over-confirm');
          const resetButton = document.getElementById('customizer-reset-button');
          const copyButton = document.getElementById('copy-button');

          // Setup reset button functionality
          if (resetButton) {
              resetButton.addEventListener('click', function () {
                  if (window.customizer && window.customizer.recipeChanged) {
                      overlayPopup.style.display = 'block';
                      startOverConfirm.style.display = 'block';
                  } else {
                      if (window.newSplide) {
                          window.newSplide.go(0);
                      }
                      if (window.customizer) {
                          window.customizer.reset();
                      }
                  }
              });
          }

          // Setup start confirmation
          const startConfirm = document.getElementById('start-confirm');
          if (startConfirm) {
              startConfirm.addEventListener('click', function () {
                  overlayPopup.style.display = 'none';
                  startOverConfirm.style.display = 'none';
                  if (window.newSplide) {
                      window.newSplide.go(0);
                  }
                  if (window.customizer) {
                      window.customizer.reset();
                  }
              });
          }

          // Function to close overlay popup
          function closeOverlayPopup() {
              overlayPopup.style.display = 'none';
              if (startOverConfirm) {
                  startOverConfirm.style.display = 'none';
              }
              if (shareLinkModal) {
                  shareLinkModal.style.display = 'none';
              }
          }

          // Setup share event listener
          document.addEventListener('customizer.shared', function (event) {
              if (shareLinkModal && overlayPopup) {
                  shareLinkModal.style.display = 'flex';
                  overlayPopup.style.display = 'block';
              }
          });

          // Setup click handlers for closing elements
          if (overlayPopup) {
              overlayPopup.addEventListener('click', closeOverlayPopup);
          }

          const shareClosed = document.getElementById('share-closed');
          if (shareClosed) {
              shareClosed.addEventListener('click', closeOverlayPopup);
          }

          const resetClosed = document.getElementById('reset-closed');
          if (resetClosed) {
              resetClosed.addEventListener('click', closeOverlayPopup);
          }

          const closeConfirm = document.getElementById('close-confirm');
          if (closeConfirm) {
              closeConfirm.addEventListener('click', closeOverlayPopup);
          }

          // Setup copy button functionality
          if (copyButton) {
              copyButton.addEventListener('click', async () => {
                  const shareLink = document.getElementById('customizer-share-link').textContent;
                  await navigator.clipboard.writeText(shareLink);
                  copyButton.textContent = 'COPIED!';
                  setTimeout(() => copyButton.textContent = 'COPY', 2000);
              });
          }
      }

      function setupSavedItems() {
          // Get the elements by their class names
          const customizerSavedItemCount = document.getElementById('customizer-saved-item-count');
          const savedInfoClosed = document.querySelector('.saved-info-closed');
          const wrapperSaved = document.querySelector('.wrapper-saved');

          if (savedInfoClosed && wrapperSaved) {
              savedInfoClosed.addEventListener('click', function () {
                  // Hide the wrapper-saved element with a 0.3-second transition
                  wrapperSaved.style.transition = 'opacity 0.3s, transform 0.3s'; // Add transition properties
                  wrapperSaved.style.opacity = '0'; // Fade out by changing opacity to 0
                  wrapperSaved.style.transform = 'scale(0)'; // Scale down to 0
                  setTimeout(function () {
                      wrapperSaved.style.display = 'none'; // Hide the element after the transition is complete
                  }, 300); // Adjust the delay to match the transition duration
              });
          }

          if (customizerSavedItemCount && wrapperSaved) {
              customizerSavedItemCount.addEventListener('click', function () {
                  // Show the wrapper-saved element with a 0.3-second transition
                  wrapperSaved.style.transition = 'opacity 0.3s, transform 0.3s'; // Add transition properties
                  wrapperSaved.style.display = 'block'; // Show the element
                  setTimeout(function () {
                      wrapperSaved.style.opacity = '1'; // Fade in by changing opacity to 1
                      wrapperSaved.style.transform = 'scale(1)'; // Scale up to 1
                  }, 0); // Use a minimal delay (0ms) to trigger the transition immediately
              });
          }
      }

      function setupViewSpecs() {
          const viewSpecsButton = document.getElementById('viewspecs');
          const summaryElement = document.getElementById('customizer-summary');
          const overlayElement = document.getElementById('overlay');

          if (viewSpecsButton && summaryElement) {
              viewSpecsButton.addEventListener('click', function () {
                  // Show the summary
                  summaryElement.style.display = 'block';
                  summaryElement.style.opacity = '1';
                  setTimeout(function () {
                      summaryElement.style.opacity = '1';
                  }, 10);

                  // Show the overlay if it exists
                  if (overlayElement) {
                      overlayElement.style.display = 'block';
                      setTimeout(function () {
                          overlayElement.style.opacity = '0.5';
                      }, 10);
                  }
              });
          }
      }

      function closeOptions() {
          const closeButtons = document.querySelectorAll('.hide-options');

          // Store initial height for main perspective
          let initialHeight = '72dvh';

          // Update initialHeight based on screen size
          const screenWidth = window.innerWidth;
          if (screenWidth > 1600) {
              initialHeight = '78dvh';
          } else if (screenWidth > 1450) {
              initialHeight = '74dvh';
          } else if (screenWidth > 1550) {
              initialHeight = '76dvh';
          }

          closeButtons.forEach(function (button) {
              button.addEventListener('click', function () {
                  const summaries = document.querySelectorAll('#customizer-tab-body-shell');
                  const mainPerspective = document.querySelector('#customizer-main-perspective');
                  const svgElement = document.querySelector('.hide-options svg');
                  const jtbModel = document.querySelector('#jtb-model');

                  mainPerspective.style.transition = 'height 0.3s';

                  if (mainPerspective.style.height === '90dvh') {
                      mainPerspective.style.height = initialHeight;
                  } else {
                      mainPerspective.style.height = '90dvh';
                  }

                  svgElement.style.transition = 'transform 0.3s';

                  if (svgElement.style.transform === 'rotate(180deg)') {
                      svgElement.style.transform = 'rotate(0deg)';

                      // Remove the class to unhide #jtb-model
                      if (jtbModel) {
                          jtbModel.classList.remove('option-hide');
                      }
                  } else {
                      svgElement.style.transform = 'rotate(180deg)';

                      // Add a class to #jtb-model to hide it
                      if (jtbModel) {
                          jtbModel.classList.add('option-hide');
                      }
                  }
              });
          });
      }

      function closeSummary() {
          const closeButtons = document.querySelectorAll('.close-submodel');
          const summaries = document.querySelectorAll('#customizer-summary');
          const overlay = document.getElementById('overlay');

          closeButtons.forEach(function (button) {
              button.addEventListener('click', function () {
                  summaries.forEach(function (summary) {
                      summary.style.transition = 'opacity 0.3s'; // Add transition property
                      summary.style.opacity = '0'; // Fade out by changing opacity to 0
                      summary.style.display = 'none';
                      setTimeout(function () {
                          lockBody();
                          summary.style.display = 'none'; // Hide elements after the transition is complete
                      }, 300); // Adjust the delay to match the transition duration
                  });

                  // Also hide overlay
                  if (overlay) {
                      overlay.style.opacity = '0';
                      setTimeout(function () {
                          overlay.style.display = 'none';
                      }, 300);
                  }
              });
          });

          if (overlay) {
              overlay.addEventListener('click', function () {
                  summaries.forEach(function (summary) {
                      summary.style.transition = 'opacity 0.3s'; // Add transition property
                      summary.style.opacity = '0'; // Fade out by changing opacity to 0
                      setTimeout(function () {
                          lockBody();
                          summary.style.display = 'none'; // Hide elements after the transition is complete
                      }, 300); // Adjust the delay to match the transition duration
                  });

                  // Also hide overlay
                  overlay.style.opacity = '0';
                  setTimeout(function () {
                      overlay.style.display = 'none';
                  }, 300);
              });
          }
      }

      function lockBody() {
          document.body.style.overflow = document.body.style.overflow === 'hidden' ? '' : 'hidden';
      }

      function setupTabNavigation() {
          const tabContainer = document.getElementById('customizer-tab-container');
          const tabs = Array.from(tabContainer.querySelectorAll('.customizer-tab'));
          const prevBtn = document.getElementById('customizer-tab-prev');
          const nextBtn = document.getElementById('customizer-tab-next');
          const counter = document.getElementById('customizer-tab-counter');
          const currentNameContainer = document.getElementById('customizer-tab-current-name');

          // Add numbered classes to tabs
          tabs.forEach((tab, index) => {
              tab.classList.add(`customizer-tab-${index + 1}`);
          });

          function getSelectedIndex() {
              return tabs.findIndex(tab => tab.classList.contains('customizer-tab-selected'));
          }

          function updateCounter() {
              const idx = getSelectedIndex();
              // Trigger CSS animation by temporarily removing and re-adding
              counter.style.animation = 'none';
              counter.offsetHeight; // Trigger reflow
              counter.style.animation = 'fadeInOut 0.6s ease-in-out';
              counter.textContent = `${idx + 1} / ${tabs.length}`;
          }

          function updateCurrentTabName(idx) {
              // Move the .customizer-tab-name node to the nav
              const tabName = tabs[idx].querySelector('.customizer-tab-name');
              if (tabName && currentNameContainer) {
                  // Trigger CSS animation by temporarily removing and re-adding
                  currentNameContainer.style.animation = 'none';
                  currentNameContainer.offsetHeight; // Trigger reflow
                  currentNameContainer.style.animation = 'fadeInOut 0.6s ease-in-out';

                  currentNameContainer.innerHTML = '';
                  currentNameContainer.appendChild(tabName.cloneNode(true));
              }
          }

          function selectTab(idx) {
              tabs.forEach(tab => tab.classList.remove('customizer-tab-selected'));
              tabs[idx].classList.add('customizer-tab-selected');
              updateCounter();
              updateCurrentTabName(idx);
              // Trigger click on the tab name to show content
              const tabName = tabs[idx].querySelector('.customizer-tab-name');
              if (tabName) tabName.click();
          }

          prevBtn.onclick = () => {
              let idx = getSelectedIndex();
              if (idx > 0) selectTab(idx - 1);
          };

          nextBtn.onclick = () => {
              let idx = getSelectedIndex();
              if (idx < tabs.length - 1) selectTab(idx + 1);
          };

          // Make tabs clickable
          tabs.forEach((tab, idx) => {
              tab.addEventListener('click', function (e) {
                  if (!tab.classList.contains('customizer-tab-selected')) {
                      selectTab(idx);
                  }
              });
          });

          // Initial counter and tab name
          updateCounter();
          updateCurrentTabName(getSelectedIndex());

          // Keyboard navigation
          document.addEventListener('keydown', (e) => {
              const modal = document.getElementById('customizer-modal');
              if (modal && !modal.classList.contains('customizer-hidden')) {
                  if (e.key === 'ArrowLeft') {
                      e.preventDefault();
                      prevBtn.click();
                  } else if (e.key === 'ArrowRight') {
                      e.preventDefault();
                      nextBtn.click();
                  }
              }
          });
      }

      setupTabBodyStepper();
      setupFontDropdownPortal();
      setupSpinnerDrag();
  });

    function setupSpinnerDrag() {
      let state = { dragging: false, startX: 0, item: null };
      
      function handleEvent(e) {
          const item = e?.target?.closest('.list-element-spinner-item');
          const clientX = e.type.includes('touch') ? (e.touches?.[0] || e.changedTouches?.[0])?.clientX : e.clientX;
          
          if (e.type.includes('down') && item?.classList.contains('customizer-selected')) {
              Object.assign(state, { dragging: true, startX: clientX, item });
              item.style.cssText += 'transition:none!important;cursor:grabbing';
              e.preventDefault();
          } else if (e.type.includes('move') && state.dragging) {
              const offset = Math.max(-25, Math.min(25, (clientX - state.startX) * 0.5));
              state.item.style.setProperty('--drag-offset', `${offset}px`);
              e.preventDefault();
          } else if ((e.type.includes('up') || e.type === 'mouseleave') && state.dragging) {
              const deltaX = (clientX || state.startX) - state.startX;
              state.item.style.removeProperty('transition');
              state.item.style.cursor = '';
              state.item.style.removeProperty('--drag-offset');
              
              if (Math.abs(deltaX) > 20) {
                  const container = state.item.closest('.list-element-spinner-container');
                  const spinner = container?.closest('.list-element-spinner');
                  const items = container.querySelectorAll('.list-element-spinner-item');
                  const currentIdx = [...items].findIndex(i => i.classList.contains('customizer-selected'));
                  const newIdx = deltaX > 0 ? currentIdx + 1 : currentIdx - 1;
                  
                  if (newIdx >= 0 && newIdx < items.length) {
                      const btn = spinner.querySelector(deltaX > 0 ? 
                          '#list-element-spinner-right, .list-element-spinner-button-right' : 
                          '#list-element-spinner-left, .list-element-spinner-button-left');
                      btn?.click();
                  }
              }
              Object.assign(state, { dragging: false, item: null });
          }
      }
      
      ['mousedown', 'touchstart', 'mousemove', 'touchmove', 'mouseup', 'touchend', 'mouseleave']
          .forEach(type => document.addEventListener(type, handleEvent, 
              type.includes('touch') ? { passive: false } : false));
  }

  function setupFontDropdownPortal() {
      let activeDropdown = null, activeContainer = null;

      function positionDropdown(dropdown, trigger) {
          const rect = trigger.getBoundingClientRect();
          let top = rect.top - dropdown.offsetHeight - 5;
          let left = Math.max(10, Math.min(rect.left, window.innerWidth - dropdown.offsetWidth - 10));

          if (top < 10) top = rect.bottom + 5;

          Object.assign(dropdown.style, {
              position: 'fixed', zIndex: '9999',
              top: top + 'px', left: left + 'px'
          });
      }

      function showDropdown(dropdown, trigger) {
          if (activeDropdown !== dropdown) {
              hideDropdown();
              activeDropdown = dropdown;
              activeContainer = dropdown.parentElement;
              document.body.appendChild(dropdown);
              positionDropdown(dropdown, trigger);
          }
      }

      function hideDropdown() {
          if (activeDropdown) {
              activeContainer.appendChild(activeDropdown);
              Object.assign(activeDropdown.style, { position: '', top: '', left: '', zIndex: '' });
              activeDropdown = activeContainer = null;
          }
      }

      document.addEventListener('click', function (e) {
          const fontSelector = e.target.closest('.input-element-font-selector-container');
          if (fontSelector) {
              const dropdown = fontSelector.querySelector('.font-dropdown-menu');
              if (dropdown) setTimeout(() => dropdown.offsetParent && showDropdown(dropdown, fontSelector), 10);
          } else if (activeDropdown && !e.target.closest('.font-dropdown-menu')) {
              hideDropdown();
          }
      });

      ['scroll', 'resize'].forEach(event =>
          window.addEventListener(event, () =>
              activeDropdown && positionDropdown(activeDropdown, activeContainer), true)
      );
  }

  function setupTabBodyStepper() {
      function addSimpleScrollArrows() {
          const bodyElements = document.querySelectorAll('.customizer-tab-body-elements');

          bodyElements.forEach(container => {
              const elements = container.querySelectorAll('.customizer-element');
              if (elements.length === 0) return;

              // Force layout calculation
              container.offsetWidth;

              // Wait for next frame to ensure proper rendering
              requestAnimationFrame(() => {
                  const needsScrolling = container.scrollWidth > container.clientWidth;
                  console.log('Container:', container, 'ScrollWidth:', container.scrollWidth, 'ClientWidth:', container.clientWidth, 'Needs scrolling:', needsScrolling);

                  let prevBtn = container.parentElement.querySelector('.customizer-body-stepper-prev');
                  let nextBtn = container.parentElement.querySelector('.customizer-body-stepper-next');

                  if (needsScrolling) {
                      container.classList.add('has-horizontal-overflow');
                      // Add smooth transition for separators
                      setTimeout(() => container.classList.add('show-separators'), 10);

                      // Determine scroll distance based on screen size
                      const scrollDistance = window.innerWidth < 400 ? 200 : 400;

                      if (!prevBtn) {
                          prevBtn = document.createElement('div');
                          prevBtn.className = 'customizer-body-stepper-btn customizer-body-stepper-prev';
                          prevBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="20" height="20"><path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"></path></svg>';
                          container.parentElement.style.position = 'relative';
                          container.parentElement.appendChild(prevBtn);

                          prevBtn.onclick = () => container.scrollBy({ left: -scrollDistance, behavior: 'smooth' });
                          console.log('Added prev button');
                      } else {
                          // Update existing button's scroll distance
                          prevBtn.onclick = () => container.scrollBy({ left: -scrollDistance, behavior: 'smooth' });
                      }

                      if (!nextBtn) {
                          nextBtn = document.createElement('div');
                          nextBtn.className = 'customizer-body-stepper-btn customizer-body-stepper-next';
                          nextBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="20" height="20"><path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"></path></svg>';
                          container.parentElement.appendChild(nextBtn);

                          nextBtn.onclick = () => container.scrollBy({ left: scrollDistance, behavior: 'smooth' });
                          console.log('Added next button');
                      } else {
                          // Update existing button's scroll distance
                          nextBtn.onclick = () => container.scrollBy({ left: scrollDistance, behavior: 'smooth' });
                      }

                      prevBtn.style.display = 'block';
                      nextBtn.style.display = 'block';
                  } else {
                      container.classList.remove('has-horizontal-overflow', 'show-separators');
                      if (prevBtn) prevBtn.style.display = 'none';
                      if (nextBtn) nextBtn.style.display = 'none';
                  }
              });
          });
      }

      // Try multiple times and also listen for tab changes
      setTimeout(addSimpleScrollArrows, 2000);
      setTimeout(addSimpleScrollArrows, 4000);

      // Also run when tabs change with shorter delay
      document.addEventListener('click', function (e) {
          if (e.target.closest('.customizer-tab-name')) {
              setTimeout(addSimpleScrollArrows, 200);
          }
      });
  }
</script>