<script>
  const params = new URLSearchParams(window.location.search);
  const productId = params.get("product"); // or "variant" or whatever param you use
  const recipeId = params.get("recipe_id");
  if (productId) {
    let variant;
    if(productId === 'fielders'){
        variant = '{{ section.settings.proKipFieldersId }}'
    } else if(productId === 'catchers'){
        variant = '{{ section.settings.proKipCatchersId }}'
    } else if(productId === 'firstBase'){
        variant = '{{ section.settings.proKipFirstBaseId }}'
    } else if(productId === 'japanKip'){
        variant = '{{ section.settings.japanKipUpliftId }}'
    } else if(productId === 'flag'){
        variant = '{{ section.settings.flagUpliftId }}'
    }
    const script = document.createElement("script");
    script.id = "customizer";
    script.src = "https://vu-customizer.s3.amazonaws.com/production/vu_customizer.js";
    script.setAttribute("data-variant", variant);
    script.setAttribute("data-status", "draft");
    script.setAttribute("data-uplift-japan-kip", '{{ section.settings.japanKipUpliftId }}');
    script.setAttribute("data-uplift-flag", '{{ section.settings.flagUpliftId }}');
    if(recipeId){
        script.setAttribute("data-recipe-id", recipeId);
    }
    
    script.defer = true;
    document.body.appendChild(script);
    document.addEventListener('DOMContentLoaded', function () {
      const modal = document.getElementById('customizer-modal');
        modal.classList.remove('customizer-hidden');
        document.body.style.overflow = 'hidden'; // Prevent scrolling when modal is open
    });
  }
</script>
