<style>
  #customizer-modal {
    font-family: var(--font-body-family);
    --text-color: {{section.settings.text_color}};
    --text-secondary-color: {{section.settings.secondary_text_color}};
    --image-size:{{ section.settings.image_size | default: 'var(--image-size)' }}px;
    --buttons-radius: {{ section.settings.buttons_radius | default: 'var(--buttons-radius)' }}px;
    --other-radius: {{ section.settings.other_radius | default: 'var(--other-radius)' }}px;
    --background-seconday-color: {{ section.settings.background_seconday_color | default: 'var(--background-seconday-color)' }};
    {% if section.settings.font_heading_family %}
    --font-heading-family: {{ section.settings.font_heading_family.family }}, {{ section.settings.font_heading_family.fallback_families }};
    {% endif %}
    {% if section.settings.font_body_family %}
    --font-body-family: {{ section.settings.font_body_family.family }}, {{ section.settings.font_body_family.fallback_families }};
    {% endif %}
    {% if section.settings.brand_color %}
    --brand-color: {{ section.settings.brand_color }};
    {% endif %}
    {% if section.settings.title_size %}
    --font-title-size: {{ section.settings.title_size }}px;
    {%endif%}
    
  }
  #customizer-main-perspective {
    {% if section.settings.background_image %}
      background-image: url({{ section.settings.background_image | image_url }});
    {% else %}
      box-shadow: 0 0 10px 0 rgba(0, 0, 0, 0.1);
    {% endif %}
  }
  {% if section.settings.font_heading_family %}
    {{ section.settings.font_heading_family | font_face }}
  {% endif %}
  {% if section.settings.font_body_family %}
    {{ section.settings.font_body_family | font_face }}
  {% endif %}
  {% if section.settings.hide_header_tabs %}
    {% assign hide_tabs = section.settings.hide_header_tabs | split: ',' %}
    {% for tab_num in hide_tabs %}
      {% assign clean_tab_num = tab_num | strip %}
      .customizer-tab-{{ clean_tab_num }} {
        display: none !important;
        visibility: hidden;
      }
      @media screen and (max-width: 375px){
        .customizer-tab-header{
          display: none;
        }
      }
    {% endfor %}
  {% endif %}

</style>
